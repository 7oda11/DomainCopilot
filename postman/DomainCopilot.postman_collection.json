{
  "info": {
    "_postman_id": "f3892253-b90f-45b9-9ce3-02b9ad9f31a4",
    "name": "Domain Copilot API",
    "description": "Local API collection. Register and log in to save a bearer token. Public registration creates a Researcher; case creation and approval require a trusted Clinician role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5161", "type": "string" },
    { "key": "email", "value": "researcher@example.test", "type": "string" },
    { "key": "password", "value": "Use-a-unique-password-123", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "caseId", "value": "", "type": "string" },
    { "key": "draftId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login (saves token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().accessToken); }"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        { "name": "Liveness", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] } } },
        { "name": "Readiness (SQL Server)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] } } }
      ]
    },
    {
      "name": "Documents and retrieval",
      "item": [
        { "name": "Upload PDF or DOCX", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }, { "key": "version", "value": "v1", "type": "text" }] }, "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api", "documents"] } } },
        { "name": "Search documents", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"query\": \"synthetic workflow guidance\",\n  \"limit\": 5\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/search", "host": ["{{baseUrl}}"], "path": ["api", "search"] } } }
      ]
    },
    {
      "name": "Clinical workflow (Clinician role required)",
      "item": [
        { "name": "Create synthetic case", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('caseId', pm.response.json().caseId); }"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"syntheticCaseSummary\": \"Synthetic test scenario only\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/cases", "host": ["{{baseUrl}}"], "path": ["api", "cases"] } } },
        { "name": "Get case", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/cases/{{caseId}}", "host": ["{{baseUrl}}"], "path": ["api", "cases", "{{caseId}}"] } } },
        { "name": "Create copilot draft", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200 && pm.response.json().draftId) { pm.collectionVariables.set('draftId', pm.response.json().draftId); }"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"question\": \"Summarize the relevant synthetic evidence and cite sources.\",\n  \"evidenceLimit\": 5\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/copilot/drafts", "host": ["{{baseUrl}}"], "path": ["api", "copilot", "drafts"] } } },
        { "name": "Review draft", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"action\": \"Rejected\",\n  \"comment\": \"Synthetic test review\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/drafts/{{draftId}}/review", "host": ["{{baseUrl}}"], "path": ["api", "drafts", "{{draftId}}", "review"] } } }
      ]
    }
  ]
}
